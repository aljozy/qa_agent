# AI Model Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# Vector Store Configuration (Qdrant)
VECTOR_STORE_HOST=localhost
VECTOR_STORE_PORT=6333
VECTOR_STORE_COLLECTION=qa_agent_requirements
VECTOR_STORE_API_KEY=

# Embedding Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# MCP Server Configuration
MCP_GITHUB_ENABLED=false
MCP_GITHUB_URL=http://localhost:3000
MCP_GITHUB_TOKEN=

MCP_OPENAPI_ENABLED=false
MCP_OPENAPI_URL=http://localhost:3001

MCP_DATABASE_ENABLED=false
MCP_DATABASE_URL=http://localhost:3002

# Output Configuration
OUTPUT_DIR=./output
OUTPUT_FORMAT=json
TEST_LANGUAGE=python
TEST_FRAMEWORK=pytest

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Performance Configuration
RAG_TOP_K=10
MAX_REQUIREMENTS=10000
SEARCH_TIMEOUT_MS=500
EXECUTION_TIMEOUT_MINUTES=5

# GitHub Integration (when MCP GitHub is enabled)
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_BRANCH=main
GITHUB_ARTIFACTS_DIR=tests/generated
